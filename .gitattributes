# Normalize text in the Git index, then select deterministic checkout endings.
* text=auto

# Repository metadata and environment templates
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
*.env.example text eol=lf

# Linux/Docker/configuration files
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.xml text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must not undergo text conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.tif binary
*.tiff binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.rar binary
*.gz binary
*.tgz binary
*.tar binary
*.ppt binary
*.pptx binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.mp4 binary
*.mov binary
*.avi binary
*.mkv binary
*.webm binary
*.wav binary
*.mp3 binary
*.m4a binary
