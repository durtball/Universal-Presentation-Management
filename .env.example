# Local-development placeholders only. Never use these values in production.
UPM_CENTRAL_PROJECT_NAME=upm-central-local
CENTRAL_HTTP_PORT=8080
CENTRAL_POSTGRES_DB=upm_central
CENTRAL_POSTGRES_USER=upm_central_local
CENTRAL_POSTGRES_PASSWORD=replace-with-a-local-central-password
UPM_CENTRAL_DATABASE_URL=postgresql+psycopg://upm_central_local:replace-with-a-local-central-password@central-postgres:5432/upm_central
UPM_CENTRAL_WORKER_CAPABILITIES=cpu,pdf-conversion,transfer
UPM_CENTRAL_WORKER_POLL_INTERVAL_SECONDS=1
UPM_CENTRAL_WORKER_LEASE_SECONDS=60
UPM_CENTRAL_ADMIN_TOKEN=replace-with-at-least-32-random-characters
UPM_CENTRAL_CREDENTIAL_ISSUER_KEY=replace-with-a-different-32-character-random-secret
UPM_CENTRAL_PUBLIC_URL=http://upm-central
UPM_INTEGRATION_NETWORK=upm-integration
UPM_INTEGRATION_NETWORK_EXTERNAL=true

UPM_SITE_PROJECT_NAME=upm-site-local
SITE_HTTP_PORT=9080
SITE_POSTGRES_DB=upm_site
SITE_POSTGRES_USER=upm_site_local
SITE_POSTGRES_PASSWORD=replace-with-a-local-site-password
UPM_SITE_DATABASE_URL=postgresql+psycopg://upm_site_local:replace-with-a-local-site-password@site-postgres:5432/upm_site
SITE_MEDIA_HOST_PATH=./.local/site/media
UPM_SITE_MEDIA_MOUNT_PATH=/var/lib/upm/media
UPM_SITE_MAX_UPLOAD_BYTES=549755813888
UPM_SITE_STAGING_MAX_AGE_SECONDS=86400
UPM_SITE_WORKER_CAPABILITIES=cpu,pdf-conversion,transfer
UPM_SITE_WORKER_POLL_INTERVAL_SECONDS=1
UPM_SITE_WORKER_LEASE_SECONDS=60
UPM_SITE_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
UPM_SITE_CENTRAL_URL=http://upm-central
UPM_SITE_DEFAULT_DISPLAY_NAME=Development Site
