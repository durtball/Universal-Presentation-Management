<Window x:Class="UPM.Signage.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UPM Signage">
<Grid x:Name="WindowRoot" Background="#0A0F16" IsTabStop="True" KeyDown="WindowKeyDown"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Background="#080C11" BorderBrush="#263240" BorderThickness="0,0,0,1" Padding="18,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="UPM" FontSize="24" FontWeight="Bold"/><TextBlock Text="SIGNAGE" FontSize="22" Foreground="#3787FF"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><TextBlock x:Name="ServiceStatus" Text="Discovering Signage…" VerticalAlignment="Center" Foreground="#9AA5B3"/><Button Content="OPERATOR" Click="OperatorClick"/><Button Content="PLAYER" Click="PlayerClick"/></StackPanel></Grid></Border>
 <Grid Grid.Row="1"><Grid x:Name="OperatorPanel"><WebView2 x:Name="Designer" Visibility="Collapsed" CoreProcessFailed="DesignerProcessFailed" WebMessageReceived="DesignerMessageReceived" NavigationCompleted="DesignerNavigationCompleted"/><Grid x:Name="DiscoveryPanel" Background="#0A0F16"><StackPanel Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><ProgressRing x:Name="DiscoveryProgress" IsActive="True"/><TextBlock x:Name="DiscoveryTitle" Text="Finding UPM Signage…" FontSize="28" TextAlignment="Center"/><TextBlock x:Name="DiscoveryMessage" Foreground="#9AA5B3" TextAlignment="Center" TextWrapping="Wrap"/><ComboBox x:Name="DiscoveredServers" Header="UPM Signage systems" DisplayMemberPath="SiteName" Visibility="Collapsed" SelectionChanged="DiscoveredServerChanged"/><Button Content="RETRY" Click="RetryDiscoveryClick" HorizontalAlignment="Center"/><Expander Header="Advanced / Manual Connection"><StackPanel Spacing="8"><TextBox x:Name="ManualEndpoint" Header="HTTPS endpoint" PlaceholderText="https://hostname:8445"/><Button Content="CONNECT" Click="ManualConnectClick"/></StackPanel></Expander></StackPanel></Grid></Grid>
 <Grid x:Name="PlayerPanel" Visibility="Collapsed"><WebView2 x:Name="Player" CoreProcessFailed="PlayerProcessFailed" WebMessageReceived="PlayerMessageReceived"/><Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12" Background="#EE111821" CornerRadius="6"><StackPanel Spacing="7" Width="280"><TextBlock Text="Player settings" FontSize="18"/><ComboBox x:Name="Monitor" Header="Monitor"/><ToggleSwitch x:Name="Fullscreen" Header="Fullscreen" IsOn="True"/><StackPanel Orientation="Horizontal" Spacing="8"><NumberBox x:Name="PlayerWidth" Header="Width" Value="1080" Minimum="320"/><NumberBox x:Name="PlayerHeight" Header="Height" Value="1920" Minimum="240"/></StackPanel><ToggleSwitch x:Name="StartWithWindows" Header="Start at Windows login"/><Button Content="APPLY PLAYER SETTINGS" Click="ApplyPlayerClick"/><Button Content="UNPAIR DISPLAY" Click="UnpairLocalClick"/><TextBlock x:Name="Diagnostics" Text="Renderer starting…" TextWrapping="Wrap" Foreground="#9AA5B3"/></StackPanel></Border></Grid></Grid>
</Grid></Window>
