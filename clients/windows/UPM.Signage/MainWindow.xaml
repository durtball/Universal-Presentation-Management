<Window x:Class="UPM.Signage.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UPM Signage">
<Grid Background="#0A0F16"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Background="#080C11" BorderBrush="#263240" BorderThickness="0,0,0,1" Padding="18,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="UPM" FontSize="24" FontWeight="Bold"/><TextBlock Text="SIGNAGE" FontSize="22" Foreground="#3787FF"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><TextBlock x:Name="ServiceStatus" Text="Not connected" VerticalAlignment="Center" Foreground="#9AA5B3"/><Button Content="OPERATOR" Click="OperatorClick"/><Button Content="PLAYER" Click="PlayerClick"/></StackPanel></Grid></Border>
 <Grid Grid.Row="1"><Grid x:Name="OperatorPanel" Padding="24"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer><StackPanel Spacing="12"><TextBlock Text="Operator setup" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Connect to the independent Signage service. The operator password remains in memory for this session." TextWrapping="Wrap" Foreground="#9AA5B3"/><TextBox x:Name="ServerUrl" Header="Signage server"/><PasswordBox x:Name="OperatorPassword" Header="Operator password"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="TEST CONNECTION" Click="TestClick"/><Button Content="LOGIN" Click="LoginClick"/></StackPanel><Border Height="1" Background="#263240" Margin="0,8"/><TextBlock Text="Pair and assign display" FontSize="20"/><TextBox x:Name="DisplayName" Header="Display name" Text="Room door"/><ComboBox x:Name="DisplayMode" Header="Mode" SelectedIndex="0"><ComboBoxItem Content="room_door"/><ComboBoxItem Content="playlist"/></ComboBox><ComboBox x:Name="AspectRatio" Header="Aspect ratio" SelectedIndex="0"><ComboBoxItem Content="9:16"/><ComboBoxItem Content="16:9"/></ComboBox><TextBox x:Name="EventId" Header="Event UUID (room door)"/><TextBox x:Name="RoomId" Header="Room UUID (room door)"/><Button Content="PAIR AND SAVE CREDENTIAL" Click="PairClick"/><TextBlock x:Name="OperatorMessage" TextWrapping="Wrap" Foreground="#8FA4B8"/></StackPanel></ScrollViewer><Grid Grid.Column="1" Margin="20,0,0,0"><TextBlock x:Name="DesignerUnavailable" Text="Log in to open the real Signage designer." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9AA5B3"/><WebView2 x:Name="Designer" Visibility="Collapsed" NavigationCompleted="DesignerNavigationCompleted"/></Grid></Grid>
 <Grid x:Name="PlayerPanel" Visibility="Collapsed"><WebView2 x:Name="Player" CoreProcessFailed="PlayerProcessFailed" WebMessageReceived="PlayerMessageReceived"/><Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12" Background="#DD111821" CornerRadius="6"><StackPanel Spacing="7" Width="280"><TextBlock Text="Player settings" FontSize="18"/><ComboBox x:Name="Monitor" Header="Monitor"/><ToggleSwitch x:Name="Fullscreen" Header="Fullscreen" IsOn="True"/><StackPanel Orientation="Horizontal" Spacing="8"><NumberBox x:Name="PlayerWidth" Header="Width" Value="1080" Minimum="320"/><NumberBox x:Name="PlayerHeight" Header="Height" Value="1920" Minimum="240"/></StackPanel><ToggleSwitch x:Name="StartWithWindows" Header="Start at Windows login"/><Button Content="APPLY PLAYER SETTINGS" Click="ApplyPlayerClick"/><TextBlock x:Name="Diagnostics" Text="Renderer starting…" TextWrapping="Wrap" Foreground="#9AA5B3"/></StackPanel></Border></Grid></Grid>
</Grid></Window>
