<Window x:Class="UPM.RoomAgent.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tb="using:H.NotifyIcon" Title="UPM Room Agent">
 <Grid Background="{StaticResource GraphiteBrush}"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="UPM Room Agent" MenuActivation="RightClick" PopupActivation="DoubleClick">
   <tb:TaskbarIcon.IconSource><tb:GeneratedIconSource Text="UPM" Foreground="#26E6FF" Background="#080D14" FontSize="18"/></tb:TaskbarIcon.IconSource>
   <tb:TaskbarIcon.ContextMenu><MenuFlyout><MenuFlyoutItem Text="Open UPM Room Agent" Click="TrayOpenClick"/><MenuFlyoutItem Text="Open Upload Kiosk" Click="TrayKioskClick"/><MenuFlyoutItem Text="Sync Now" Click="SyncClick"/><MenuFlyoutItem Text="Status" Click="TrayStatusClick"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Exit UPM Room Agent" Click="TrayExitClick"/></MenuFlyout></tb:TaskbarIcon.ContextMenu>
  </tb:TaskbarIcon>
  <Border Background="#EF080E16" BorderBrush="#304B60" BorderThickness="0,0,0,1" Padding="20,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="UPM" Foreground="{StaticResource AccentBrush}" FontSize="27" FontWeight="Bold"/><StackPanel><TextBlock Text="ROOM AGENT" FontSize="14" CharacterSpacing="120"/><TextBlock x:Name="IdentityText" Text="Connecting to local Agent…" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center"><StackPanel><TextBlock Style="{StaticResource LabelStyle}" Text="AGENT"/><TextBlock x:Name="AgentStatusText" Text="CONNECTING"/></StackPanel><StackPanel><TextBlock Style="{StaticResource LabelStyle}" Text="SITE"/><TextBlock x:Name="SiteStatusText" Text="UNKNOWN"/></StackPanel><Button Content="SYNC NOW" Click="SyncClick"/></StackPanel>
  </Grid></Border>
  <NavigationView Grid.Row="1" x:Name="Navigation" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="NavigationChanged">
   <NavigationView.MenuItems><NavigationViewItem Content="Room" Tag="room" Icon="Home"/><NavigationViewItem Content="Upload Kiosk" Tag="kiosk" Icon="Upload"/><NavigationViewItem Content="Settings" Tag="settings" Icon="Setting"/></NavigationView.MenuItems>
   <Grid>
    <ScrollViewer x:Name="RoomView"><StackPanel Padding="22" Spacing="16" MaxWidth="1220" HorizontalAlignment="Stretch">
     <InfoBar x:Name="OfflineBar" IsOpen="False" Severity="Warning" Title="SITE OFFLINE" Message="Using cached data. Presentations already downloaded remain available."/>
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource PanelStyle}"><StackPanel Spacing="10"><TextBlock Style="{StaticResource LabelStyle}" Text="CURRENT SESSION"/><TextBlock x:Name="CurrentTitle" Text="No current session" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="CurrentIdentifier" Foreground="{StaticResource AccentBrush}" FontSize="18"/><TextBlock x:Name="CurrentTime" FontSize="17"/><TextBlock x:Name="CurrentPresenter" Foreground="{StaticResource MutedBrush}" FontSize="15"/><Separator/><TextBlock Style="{StaticResource LabelStyle}" Text="PRESENTATION"/><TextBlock x:Name="PresentationTitle" Text="Not available" FontSize="20"/><TextBlock x:Name="OriginalFilename" Text="—" Foreground="{StaticResource MutedBrush}"/><StackPanel Orientation="Horizontal" Spacing="10"><Border Background="#263852" CornerRadius="4" Padding="9,4"><TextBlock x:Name="ReadinessText" Text="NOT AVAILABLE" FontWeight="Bold"/></Border><TextBlock x:Name="RotationText" Text="Rotating slides: Day / Global" VerticalAlignment="Center"/></StackPanel></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource PanelStyle}"><StackPanel Spacing="9"><TextBlock Style="{StaticResource LabelStyle}" Text="NEXT SESSION"/><TextBlock x:Name="NextTitle" Text="None scheduled" FontSize="21" TextWrapping="Wrap"/><TextBlock x:Name="NextTime" Foreground="{StaticResource MutedBrush}"/><Separator/><TextBlock Style="{StaticResource LabelStyle}" Text="ROOM STATUS"/><TextBlock x:Name="EventRoomText" Text="—"/><TextBlock x:Name="LastSyncText" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource PanelStyle}"><StackPanel Orientation="Horizontal" Spacing="9"><Button Content="OPEN PRESENTATION" Click="OpenPresentationClick"/><Button Content="OPEN PRESENTATION FOLDER" Click="OpenFolderClick"/><Button Content="◀ PREVIOUS" Click="PreviousClick"/><Button Content="NEXT ▶" Click="NextClick"/><Button Content="REPLACE / INTAKE" Click="IntakeClick"/><Button x:Name="OpenKioskButton" Content="OPEN UPLOAD KIOSK" Click="OpenKioskClick"/><Button Content="REPORT PROBLEM" Click="ReportProblemClick"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"><StackPanel Padding="22" Spacing="14" MaxWidth="1000"><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold"/>
     <Expander Header="Presentation Library" IsExpanded="True"><StackPanel Spacing="8" Padding="12"><ToggleSwitch x:Name="LibraryEnabled" Header="Enable Desktop UPM Presentations folder"/><ToggleSwitch x:Name="LibraryVisible" Header="Show presentation folder"/><TextBox x:Name="LibraryPath" Header="Folder path"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="OPEN FOLDER" Click="OpenFolderClick"/><Button Content="REBUILD FOLDER" Click="RebuildClick"/></StackPanel><NumberBox x:Name="KeepDays" Header="Keep completed days" Minimum="0"/><NumberBox x:Name="PreviousDays" Header="Retain previous versions (days)" Minimum="0"/></StackPanel></Expander>
     <Expander Header="Presentation Behavior"><StackPanel Spacing="8" Padding="12"><ToggleSwitch x:Name="AutomaticDownloads" Header="Automatic downloads"/><ToggleSwitch x:Name="AutomaticActivation" Header="Activate after verification"/><TextBox x:Name="DefaultApplication" Header="Default presentation application"/><ToggleSwitch x:Name="AutoLaunch" Header="Auto-launch presentation (default OFF)"/><NumberBox x:Name="CacheDays" Header="Cache retention days" Minimum="1"/></StackPanel></Expander>
     <Expander Header="Synchronization"><StackPanel Padding="12" Spacing="8"><TextBlock x:Name="SyncSettingsStatus"/><Button Content="SYNC NOW" Click="SyncClick"/><Button Content="RECONCILE CACHE" Click="RebuildClick"/><NumberBox x:Name="Concurrency" Header="Transfer concurrency" Minimum="1" Maximum="8"/></StackPanel></Expander>
     <Expander Header="Site Connection"><StackPanel Padding="12" Spacing="8"><TextBlock x:Name="ProvisioningSummary"/><TextBlock Text="Site discovery and enrollment are automatic. Assignment is managed at Site." Foreground="{StaticResource MutedBrush}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="RESET DISCOVERY" Click="ResetDiscoveryClick"/><Button Content="TEST CONNECTION" Click="SyncClick"/></StackPanel><Expander Header="Diagnostics — Advanced"><StackPanel Padding="8" Spacing="8"><TextBlock Text="Emergency troubleshooting only. Normal setup never requires addresses or identifiers." TextWrapping="Wrap"/><Button Content="MANUAL SITE CONFIGURATION…" Click="ProvisionClick"/><Button Content="FORGET SITE" Click="UnprovisionClick"/></StackPanel></Expander></StackPanel></Expander>
     <Expander Header="Kiosk and Startup"><StackPanel Padding="12" Spacing="8"><ToggleSwitch x:Name="StartWithWindows" Header="Start UPM Room Agent with Windows"/><ToggleSwitch x:Name="KioskEnabled" Header="Kiosk enabled"/><ToggleSwitch x:Name="KioskAutoLaunch" Header="Auto-launch kiosk"/><ToggleSwitch x:Name="KioskFullscreen" Header="Fullscreen"/><NumberBox x:Name="KioskMonitor" Header="Display / monitor" Minimum="0"/><ToggleSwitch x:Name="KioskStart" Header="Start kiosk after Room Agent starts"/><ToggleSwitch x:Name="KioskOffline" Header="Offline availability"/><Button Content="LAUNCH KIOSK" Click="OpenKioskClick"/></StackPanel></Expander>
     <Expander Header="Branding"><StackPanel Padding="12" Spacing="6"><TextBlock x:Name="BrandingSummary"/><Button Content="PREVIEW BRANDING" Click="OpenKioskClick"/><Button Content="RE-DOWNLOAD BRANDING" Click="SyncClick"/></StackPanel></Expander>
     <Expander Header="Diagnostics"><StackPanel Padding="12" Spacing="6"><TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="OPEN LOGS" Click="OpenLogsClick"/><Button Content="EXPORT DIAGNOSTICS" Click="ExportDiagnosticsClick"/><Button Content="RESTART DISCOVERY" Click="ResetDiscoveryClick"/></StackPanel></StackPanel></Expander>
     <Button Content="SAVE SETTINGS" HorizontalAlignment="Left" Click="SaveSettingsClick"/>
    </StackPanel></ScrollViewer>
    <Grid x:Name="KioskView" Visibility="Collapsed" Background="#101925"><Image x:Name="KioskBackground" Stretch="UniformToFill" Opacity="0.35"/><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="700" Spacing="20"><Image x:Name="KioskLogo" Height="120" Stretch="Uniform"/><TextBlock x:Name="KioskEvent" Text="UPM Upload Kiosk" FontSize="42" FontWeight="Bold" TextAlignment="Center"/><TextBlock x:Name="KioskWelcome" FontSize="22" TextAlignment="Center"/><TextBlock x:Name="KioskInstructions" Text="Choose your presentation to upload or replace." FontSize="18" TextAlignment="Center" TextWrapping="Wrap"/><Button Content="CHOOSE PRESENTATION" FontSize="20" Padding="28,16" HorizontalAlignment="Center" Click="KioskIntakeClick"/><InfoBar x:Name="KioskFeedback" IsOpen="False" IsClosable="True"/><TextBlock x:Name="KioskConnection" TextAlignment="Center"/><Button Content="RETURN TO ROOM" HorizontalAlignment="Center" Click="ReturnRoomClick"/></StackPanel></Grid></Grid>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
