<Application x:Class="UPM.RoomAgent.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark">
  <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="GraphiteBrush" Color="#080D14"/><SolidColorBrush x:Key="PanelBrush" Color="#E50D1620"/><SolidColorBrush x:Key="AccentBrush" Color="#26E6FF"/><SolidColorBrush x:Key="MutedBrush" Color="#92A8B8"/><SolidColorBrush x:Key="SuccessBrush" Color="#55E879"/><SolidColorBrush x:Key="FailureBrush" Color="#FF5C68"/>
    <Style TargetType="Button"><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style x:Key="PanelStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="#334B5E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18"/></Style>
    <Style x:Key="LabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="CharacterSpacing" Value="80"/></Style>
  </ResourceDictionary></Application.Resources>
</Application>
