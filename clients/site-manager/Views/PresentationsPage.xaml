<Page x:Class="UPM.SiteManager.Views.PresentationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded" Unloaded="OnUnloaded">
 <Grid Padding="20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="PRESENTATIONS"/><TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" Text="Authoritative event presentation operations"/></StackPanel><TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search title, presenter, session…" TextChanged="OnSearchChanged"/><Button Grid.Column="2" Click="OnRefresh" Content="REFRESH"/></Grid>
  <InfoBar x:Name="StateBar" Grid.Row="1" IsOpen="False"/>
  <ListView x:Name="PresentationList" Grid.Row="2" SelectionMode="Extended"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource ControlRoomPanelStyle}" Padding="10" Margin="0,0,0,5"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
   <TextBlock Foreground="{StaticResource AccentBrush}" Text="{Binding Status}"/><TextBlock Grid.Column="1" Text="{Binding Start}"/><TextBlock Grid.Column="2" Text="{Binding Room}"/><StackPanel Grid.Column="3"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Filename}"/></StackPanel><TextBlock Grid.Column="4" Text="{Binding Session}" TextWrapping="Wrap"/><TextBlock Grid.Column="5" Text="{Binding Presenter}" TextWrapping="Wrap"/><TextBlock Grid.Column="6" Text="{Binding Version}"/><StackPanel Grid.Column="7"><TextBlock Text="{Binding Size}"/><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Modified}"/></StackPanel>
  </Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
 </Grid>
</Page>
