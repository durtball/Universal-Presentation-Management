<Page x:Class="UPM.SiteManager.Views.PresentationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded" Unloaded="OnUnloaded">
 <Grid Padding="12" RowSpacing="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="140"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="RoomFilter" SelectedIndex="0" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="All Rooms"/></ComboBox><ComboBox x:Name="StatusFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="All Status"/><ComboBoxItem Content="Ready"/><ComboBoxItem Content="Missing"/><ComboBoxItem Content="Unknown"/></ComboBox><ComboBox x:Name="TypeFilter" Grid.Column="2" SelectedIndex="0" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="All Types"/><ComboBoxItem Content="PowerPoint"/><ComboBoxItem Content="PDF"/></ComboBox><TextBox x:Name="SearchBox" Grid.Column="3" PlaceholderText="Search presentations…" TextChanged="OnFilterChanged"/><Button Grid.Column="4" Content="REFRESH" Click="OnRefresh"/></Grid>
  <Grid Grid.Row="1"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="PRESENTATIONS"/><TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="Select an event"/></Grid>
  <InfoBar x:Name="StateBar" Grid.Row="2" IsOpen="False" IsClosable="True"/>
  <Grid Grid.Row="3" RowSpacing="2"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="#B20B131D" Padding="8,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource HeaderLabelStyle}" Text="START TIME" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Style="{StaticResource HeaderLabelStyle}" Text="ROOM" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Style="{StaticResource HeaderLabelStyle}" Text="SESSION" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Style="{StaticResource HeaderLabelStyle}" Text="PRESENTER" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Style="{StaticResource HeaderLabelStyle}" Text="PRESENTATION" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Style="{StaticResource HeaderLabelStyle}" Text="VERSION" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Style="{StaticResource HeaderLabelStyle}" Text="SIZE" VerticalAlignment="Center"/><TextBlock Grid.Column="7" Style="{StaticResource HeaderLabelStyle}" Text="STATUS" VerticalAlignment="Center"/></Grid><ListView x:Name="PresentationList" Grid.Row="1" SelectionMode="Extended"><ListView.ItemTemplate><DataTemplate><Grid Background="{StaticResource TableRowBrush}" Padding="8,5" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Start}"/><TextBlock Grid.Column="1" Text="{Binding Room}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Session}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding Presenter}" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="4"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Text="{Binding Filename}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="5" Text="{Binding Version}"/><TextBlock Grid.Column="6" Text="{Binding Size}"/><TextBlock Grid.Column="7" Foreground="{Binding StatusBrush}" Text="{Binding Status}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid>
 </Grid>
</Page>
