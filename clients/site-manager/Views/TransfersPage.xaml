<Page x:Class="UPM.SiteManager.Views.TransfersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded" Unloaded="OnUnloaded"><Grid Padding="20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="TRANSFERS"/><TextBlock x:Name="Totals" Foreground="{StaticResource MutedBrush}" Text="Durable profile-bound transfer queue"/></StackPanel><Button Grid.Column="1" Click="OnRefresh" Content="REFRESH"/></Grid><InfoBar x:Name="StateBar" Grid.Row="1" IsOpen="False"/><ListView x:Name="TransferList" Grid.Row="2" SelectionMode="Extended"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource ControlRoomPanelStyle}" Padding="10" Margin="0,0,0,5"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Filename}"/><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding RelativePath}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Profile}"/><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Event}"/></StackPanel><TextBlock Grid.Column="2" Foreground="{StaticResource AccentBrush}" Text="{Binding State}"/><StackPanel Grid.Column="3"><TextBlock Text="{Binding Progress}"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="{Binding Retry}"/><TextBlock Foreground="#FFCF6679" Text="{Binding Error}" TextWrapping="Wrap"/></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListVie