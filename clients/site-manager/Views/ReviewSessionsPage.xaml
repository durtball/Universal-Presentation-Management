<Page
    x:Class="UPM.SiteManager.Views.ReviewSessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="REVIEW SESSIONS" />
            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Observe room working copies, local changes, saveback, and revision conflicts" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource ControlRoomPanelStyle}" Padding="24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580" Spacing="8">
                <FontIcon Glyph="&#xE890;" FontSize="36" Foreground="{StaticResource VioletBrush}" />
                <TextBlock FontSize="18" Text="No active review sessions" />
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Open a presentation for in-room review to observe durable command and saveback state here." TextAlignment="Center" TextWrapping="Wrap" />
                <Button IsEnabled="False" Content="OPEN FOR REVIEW" ToolTipService.ToolTip="Select a presentation and room first" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
