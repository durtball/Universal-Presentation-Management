<Page x:Class="UPM.SiteManager.Views.ReviewSessionsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded" Unloaded="OnUnloaded"><Grid Padding="12" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Style="{StaticResource SectionTitleStyle}" Text="REVIEW SESSIONS"/><Button HorizontalAlignment="Right" Content="REFRESH" Click="OnRefresh"/></Grid><InfoBar x:Name="StateBar" Grid.Row="1" IsOpen="False" IsClosable="True"/><Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource ControlRoomPanelStyle}" Padding="10"><Grid RowSpacing="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="0 ACTIVE REVIEWS"/><ListView x:Name="ReviewList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Background="{StaticResource TableRowBrush}" Padding="9,6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Presentation}"/><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Text="{Binding BaseVersion}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Room}"/><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Text="{Binding Device}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Foreground="{StaticResource VioletBrush}" Text="{Binding State}"/><TextBlock FontSize="10" Text="{Binding Opened}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7"><Button Content="BRING TO FRONT" IsEnabled="False" ToolTipService.ToolTip="Requires an Agent interactive companion"/><Button Content="CLOSE REVIEW" IsEnabled="False" ToolTipService.ToolTip="Requires Agent review-control support"/></StackPanel></Grid></Border><StackPanel Grid.Column="1" Spacing="8"><Border Style="{StaticResource ControlRoomPanelStyle}" Padding="12"><StackPanel Spacing="7"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="SAVEBACK STATUS"/><TextBlock x:Name="ChangeState" Foreground="{StaticResource WarningBrush}" FontSize="14" Text="SELECT A REVIEW"/><TextBlock x:Name="ModifiedText" Text="Last Modified  —"/><TextBlock x:Name="SizeText" Text="File Size  —"/><TextBlock x:Name="HashText" Foreground="{StaticResource MutedBrush}" Text="Hash  —" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Spacing="7"><Button Content="REQUEST SAVEBACK" IsEnabled="False" ToolTipService.ToolTip="Requires Agent saveback command support"/><Button Content="IGNORE FOR NOW" IsEnabled="False" ToolTipService.ToolTip="Requires Agent review policy support"/></StackPanel></StackPanel></Border><Border Style="{StaticResource ControlRoomPanelStyle}" Padding="12"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="SESSION ACTIVITY"/><TextBlock x:Name="TimelineText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="No review selected" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></Grid></Grid></Page>
