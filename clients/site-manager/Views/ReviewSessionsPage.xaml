<Page x:Class="UPM.SiteManager.Views.ReviewSessionsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded" Unloaded="OnUnloaded"><Grid Padding="20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="REVIEW SESSIONS"/><TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" Text="Durable review, local-change and saveback state"/></StackPanel><Button Grid.Column="1" Click="OnRefresh" Content="REFRESH"/></Grid><InfoBar x:Name="StateBar" Grid.Row="1" IsOpen="False"/><ListView x:Name="ReviewList" Grid.Row="2" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource ControlRoomPanelStyle}" Padding="14" Margin="0,0,0,8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="17" Text="{Binding Presentation}"/><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding BaseVersion}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Room}"/><TextBlock Text="{Binding Device}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Foreground="{StaticResource AccentBrush}" Text="{Binding State}"/><TextBlock Text="{Binding Opened}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="{Binding Changes}"/><TextBlock Foreground="#FFD9A13B" Text="{Binding Saveback}"/></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid></Page>
