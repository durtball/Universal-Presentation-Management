<Page x:Class="UPM.SiteManager.Views.ProgramImportReviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" NavigationCacheMode="Disabled">
  <Grid Padding="12" RowSpacing="7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="PROGRAM IMPORT REVIEW"/><TextBlock x:Name="BatchSummary" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="Loading staged rows…"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6"><Button Content="BACK" Click="OnBack"/><Button Content="REFRESH" Click="OnRefresh"/><Button x:Name="CommitButton" Content="COMMIT PROGRAM" IsEnabled="False" Click="OnCommit"/></StackPanel></Grid>
    <Grid Grid.Row="1" ColumnSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="StateFilter" SelectedIndex="0" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="All Rows"/><ComboBoxItem Content="Errors"/><ComboBoxItem Content="Warnings"/><ComboBoxItem Content="Valid"/><ComboBoxItem Content="Rejected"/></ComboBox><TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search room, session, presentation, presenter, identifier or message…" TextChanged="OnFilterChanged"/></Grid>
    <InfoBar x:Name="StateBar" Grid.Row="2" IsOpen="False" IsClosable="True"/>
    <ScrollViewer Grid.Row="3" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"><Grid MinWidth="1510" RowSpacing="1"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Background="#E00B131D" Padding="7,0" ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="105"/><ColumnDefinition Width="85"/><ColumnDefinition Width="105"/><ColumnDefinition Width="190"/><ColumnDefinition Width="210"/><ColumnDefinition Width="160"/><ColumnDefinition Width="150"/><ColumnDefinition Width="78"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource HeaderLabelStyle}" Text="ROW"/><TextBlock Grid.Column="1" Style="{StaticResource HeaderLabelStyle}" Text="DATE"/><TextBlock Grid.Column="2" Style="{StaticResource HeaderLabelStyle}" Text="TIME"/><TextBlock Grid.Column="3" Style="{StaticResource HeaderLabelStyle}" Text="ROOM"/><TextBlock Grid.Column="4" Style="{StaticResource HeaderLabelStyle}" Text="SESSION"/><TextBlock Grid.Column="5" Style="{StaticResource HeaderLabelStyle}" Text="PRESENTATION"/><TextBlock Grid.Column="6" Style="{StaticResource HeaderLabelStyle}" Text="PRESENTER(S)"/><TextBlock Grid.Column="7" Style="{StaticResource HeaderLabelStyle}" Text="SOURCE ID"/><TextBlock Grid.Column="8" Style="{StaticResource HeaderLabelStyle}" Text="VALIDATION"/><TextBlock Grid.Column="9" Style="{StaticResource HeaderLabelStyle}" Text="RECONCILIATION"/><TextBlock Grid.Column="10" Style="{StaticResource HeaderLabelStyle}" Text="ERROR / WARNING"/><TextBlock Grid.Column="11" Style="{StaticResource HeaderLabelStyle}" Text="ACTIONS"/>
      </Grid>
      <ListView x:Name="RowsList" Grid.Row="1"><ListView.ItemTemplate><DataTemplate><Grid Background="{StaticResource TableRowBrush}" Padding="7,3" ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="105"/><ColumnDefinition Width="85"/><ColumnDefinition Width="105"/><ColumnDefinition Width="190"/><ColumnDefinition Width="210"/><ColumnDefinition Width="160"/><ColumnDefinition Width="150"/><ColumnDefinition Width="78"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Text="{Binding RowNumber}"/><TextBox Grid.Column="1" Text="{Binding Date, Mode=TwoWay}"/><TextBox Grid.Column="2" Text="{Binding Time, Mode=TwoWay}"/><TextBox Grid.Column="3" Text="{Binding Room, Mode=TwoWay}"/><TextBox Grid.Column="4" Text="{Binding SessionTitle, Mode=TwoWay}"/><TextBox Grid.Column="5" Text="{Binding PresentationTitle, Mode=TwoWay}"/><TextBox Grid.Column="6" Text="{Binding Presenters, Mode=TwoWay}"/><TextBox Grid.Column="7" Text="{Binding SourceIdentifier, Mode=TwoWay}"/><TextBlock Grid.Column="8" VerticalAlignment="Center" Foreground="{Binding StateBrush}" Text="{Binding ValidationState}"/><TextBlock Grid.Column="9" VerticalAlignment="Center" Foreground="{Binding ReconciliationBrush}" Text="{Binding ReconciliationState}"/><TextBlock Grid.Column="10" VerticalAlignment="Center" Foreground="{Binding StateBrush}" Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Message}"/><StackPanel Grid.Column="11" Orientation="Horizontal" Spacing="4"><Button Content="SAVE" CommandParameter="{Binding}" Click="OnSave"/><Button Content="{Binding RejectLabel}" CommandParameter="{Binding}" Click="OnToggleReject"/></StackPanel>
      </Grid></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid></ScrollViewer>
  </Grid>
</Page>
