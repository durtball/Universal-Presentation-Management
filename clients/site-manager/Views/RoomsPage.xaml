<Page
    x:Class="UPM.SiteManager.Views.RoomsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="ROOM OPERATIONS" />
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Site-authoritative assignments, readiness, cache and review state" />
            </StackPanel>
            <Button Grid.Column="1" IsEnabled="False" Content="PUSH SELECTED" ToolTipService.ToolTip="Select an event and presentation first" />
        </Grid>
        <GridView Grid.Row="1" SelectionMode="None">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemWidth="360" ItemHeight="235" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.Items>
                <Border Width="350" Height="225" Style="{StaticResource ControlRoomPanelStyle}" Padding="22">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE7F4;" FontSize="36" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock FontSize="18" Text="No rooms loaded" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="Room cards reflow automatically after an event projection is loaded." TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Foreground="#D9A13B" Text="AGENT STATE: UNKNOWN" />
                    </StackPanel>
                </Border>
            </GridView.Items>
        </GridView>
    </Grid>
</Page>
