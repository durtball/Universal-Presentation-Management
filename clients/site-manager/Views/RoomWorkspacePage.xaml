<Page x:Class="UPM.SiteManager.Views.RoomWorkspacePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="14" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="‹ ROOMS" Click="OnBack"/>
      <StackPanel Grid.Column="1"><TextBlock x:Name="RoomTitle" Style="{StaticResource SectionTitleStyle}" Text="ROOM WORKSPACE"/><TextBlock x:Name="RoomStatus" Foreground="{StaticResource MutedBrush}" Text="Loading Site-authoritative room state…"/></StackPanel>
      <Button Grid.Column="2" Content="REFRESH" Click="OnRefresh"/>
    </Grid>
    <InfoBar x:Name="StateBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>
    <Grid Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource ControlRoomPanelStyle}" Padding="10"><StackPanel><TextBlock Style="{StaticResource HeaderLabelStyle}" Text="NOW"/><TextBlock x:Name="NowTitle" FontSize="17" Text="—"/><TextBlock x:Name="NowDetail" Foreground="{StaticResource MutedBrush}" Text="No current session"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource ControlRoomPanelStyle}" Padding="10"><StackPanel><TextBlock Style="{StaticResource HeaderLabelStyle}" Text="NEXT"/><TextBlock x:Name="NextTitle" FontSize="17" Text="—"/><TextBlock x:Name="NextDetail" Foreground="{StaticResource MutedBrush}" Text="No upcoming session"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource ControlRoomPanelStyle}" Padding="10"><StackPanel><TextBlock Style="{StaticResource HeaderLabelStyle}" Text="ROOM ENDPOINTS"/><TextBlock x:Name="PrimaryAgent" Text="PRIMARY: UNASSIGNED"/><TextBlock x:Name="BackupAgent" Text="BACKUP: UNASSIGNED"/><TextBlock x:Name="Telemetry" Foreground="{StaticResource MutedBrush}" Text="Telemetry: UNKNOWN"/></StackPanel></Border>
    </Grid>
    <Grid Grid.Row="3" RowSpacing="2"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Background="#B20B131D" Padding="8,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource HeaderLabelStyle}" Text="TIME"/><TextBlock Grid.Column="1" Style="{StaticResource HeaderLabelStyle}" Text="SESSION"/><TextBlock Grid.Column="2" Style="{StaticResource HeaderLabelStyle}" Text="PRESENTER"/><TextBlock Grid.Column="3" Style="{StaticResource HeaderLabelStyle}" Text="PRESENTATION ENTRY"/><TextBlock Grid.Column="4" Style="{StaticResource HeaderLabelStyle}" Text="READINESS"/><TextBlock Grid.Column="5" Style="{StaticResource HeaderLabelStyle}" Text="ACTIONS"/></Grid>
      <ListView x:Name="ScheduleList" Grid.Row="1" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Background="{StaticResource TableRowBrush}" Padding="8,5" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Time}"/><TextBlock Grid.Column="1" Text="{Binding Session}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Presenters}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding Presentation}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="4" Text="{Binding Readiness}"/>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5"><Button Content="VIEW" CommandParameter="{Binding}" Click="OnView"/><Button Content="OPEN" CommandParameter="{Binding}" Click="OnOpen"/><Button Content="PUSH" CommandParameter="{Binding}" Click="OnPush"/><Button Content="PUSH &amp; OPEN" CommandParameter="{Binding}" Click="OnPushAndOpen"/></StackPanel>
      </Grid></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
  </Grid>
</Page>
