<Page x:Class="UPM.SiteManager.Views.DevicesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded" Unloaded="OnUnloaded">
 <Grid Padding="20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="DEVICES"/><TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" Text="Agent runtime telemetry"/></StackPanel><Button Grid.Column="1" Click="OnRefresh" Content="REFRESH"/></Grid>
  <InfoBar x:Name="StateBar" Grid.Row="1" IsOpen="False"/>
  <ListView x:Name="DeviceList" Grid.Row="2" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource ControlRoomPanelStyle}" Padding="14" Margin="0,0,0,8"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock FontSize="18" Text="{Binding Name}"/><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Hostname}"/><TextBlock Foreground="{StaticResource AccentBrush}" Text="{Binding OnlineState}"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Foreground="{StaticResource MutedBrush}" Text="ASSIGNMENT"/><TextBlock Text="{Binding Assignment}"/><TextBlock Text="{Binding Role}"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Foreground="{StaticResource MutedBrush}" Text="RUNTIME"/><TextBlock Text="{Binding Agent}"/><TextBlock Text="{Binding PowerPoint}"/><TextBlock Text="{Binding Disk}"/></StackPanel>
   <StackPanel Grid.Column="3"><TextBlock Foreground="{StaticResource MutedBrush}" Text="ACTIVITY"/><TextBlock Text="{Binding Heartbeat}"/><TextBlock Text="{Binding Current}"/><TextBlock Foreground="#FFCF6679" Text="{Binding Error}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="4" Content="ASSIGN" Tag="{Binding DeviceId}" Click="OnAssign" VerticalAlignment="Center"/>
  </Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
 </Grid>
</Page>
