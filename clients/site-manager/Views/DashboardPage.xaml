<Page x:Class="UPM.SiteManager.Views.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="20" Spacing="14"><TextBlock Text="OPERATIONS OVERVIEW" Foreground="#DCE8F2" FontWeight="SemiBold"/><ItemsRepeater ItemsSource="{x:Bind Metrics}"><ItemsRepeater.Layout><UniformGridLayout MaximumRowsOrColumns="4" MinItemWidth="190"/></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate><Border Background="#B30D1620" BorderBrush="#24485A" BorderThickness="1" CornerRadius="5" Padding="16" Margin="5"><StackPanel><TextBlock Text="{Binding Label}" Foreground="#92A8B8"/><TextBlock Text="{Binding Value}" FontSize="30" Foreground="#E9F7FF"/><TextBlock Text="{Binding Detail}" Foreground="#26E6FF"/></StackPanel></Border></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater><TextBlock Text="ROOM STATUS" Foreground="#DCE8F2"/><InfoBar IsOpen="True" Severity="Informational" Title="No live room projection" Message="Connect and select a deployed event. Agent state remains UNKNOWN until a fresh heartbeat is received."/></StackPanel></ScrollViewer></Page>
