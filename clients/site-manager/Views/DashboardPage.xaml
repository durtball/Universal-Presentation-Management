<Page
    x:Class="UPM.SiteManager.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="PageSizeChanged">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="20" Spacing="14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="OPERATIONS OVERVIEW" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{StaticResource MutedBrush}"
                        Text="Live Site status and show-readiness projection" />
                </StackPanel>
                <Button Grid.Column="1" IsEnabled="False" Content="REFRESH" ToolTipService.ToolTip="Connect to a Site to refresh" />
            </Grid>

            <GridView
                x:Name="MetricGrid"
                IsItemClickEnabled="False"
                IsTabStop="False"
                ItemsSource="{x:Bind Metrics}"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemWidth="220"
                            ItemHeight="122"
                            MaximumRowsOrColumns="8"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,10,10" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ControlRoomPanelStyle}" Padding="15">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Text="{Binding Label}" />
                                <TextBlock Margin="0,5,0,0" Foreground="#E9F7FF" FontSize="29" Text="{Binding Value}" />
                                <TextBlock Margin="0,3,0,0" Foreground="{Binding DetailBrush}" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="ROOM STATUS" />
            <Border Style="{StaticResource ControlRoomPanelStyle}" MinHeight="210" Padding="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" Spacing="9">
                    <FontIcon Glyph="&#xE7F4;" FontSize="38" Foreground="{StaticResource VioletBrush}" />
                    <TextBlock HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold" Text="No live room projection" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource MutedBrush}"
                        Text="Connect and select a deployed event to load room cards. Agent state remains UNKNOWN until fresh heartbeat telemetry is received."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
