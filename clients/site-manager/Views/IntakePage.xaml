<Page
    x:Class="UPM.SiteManager.Views.IntakePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="DragOver"
    Drop="Drop">
    <Grid x:Name="LayoutRoot" Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="HIGH-VOLUME INTAKE" />
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Files remain local until a Site and event are selected" />
            </StackPanel>
            <Button Grid.Column="1" IsEnabled="False" Content="SELECT FILES" />
            <Button Grid.Column="2" IsEnabled="False" Content="SELECT FOLDER" />
        </Grid>
        <Border Grid.Row="1" BorderBrush="#A93CDBF5" BorderThickness="2" CornerRadius="8" Background="#45131D29">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{StaticResource AccentBrush}" />
                <TextBlock FontSize="19" FontWeight="SemiBold" Text="DROP FILES OR FOLDERS" />
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Nested relative paths and source metadata are preserved" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="DURABLE TRANSFER QUEUE" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="0 queued  •  0 active  •  0 failed" />
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource ControlRoomPanelStyle}">
            <Grid>
                <ListView x:Name="Queue" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsHitTestVisible="False">
                    <TextBlock FontSize="17" Text="Intake queue is empty" />
                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Drop supported presentation or media files to begin enumeration." TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
