<Page
    x:Class="UPM.SiteManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="SITE PROFILES" />
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Saved non-secret connection details and secure session actions" />
            </StackPanel>
            <Button Grid.Column="1" Content="ADD SITE" Click="OnAddClick" />
        </Grid>
        <InfoBar x:Name="ActionInfo" Grid.Row="1" IsOpen="False" IsClosable="True" />
        <Border Grid.Row="2" Style="{StaticResource ControlRoomPanelStyle}">
            <Grid>
                <ListView x:Name="ProfileList" SelectionMode="Single" IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="72" Padding="10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding BaseUri}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding CanonicalSiteDisplayName, TargetNullValue='Not verified'}" />
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding CanonicalSiteId, TargetNullValue='Canonical Site ID not verified'}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="LAST CONNECTED" />
                                    <TextBlock Text="{Binding LastConnectedAt, TargetNullValue='Never'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Foreground="{StaticResource AccentBrush}" Text="{Binding Status}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyProfiles" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="No saved Site profiles. Add a Site to begin." />
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Content="CONNECT" Click="OnConnectClick" />
            <Button Content="TEST" Click="OnTestClick" />
            <Button Content="EDIT" Click="OnEditClick" />
            <Button Content="DISCONNECT" Click="OnDisconnectClick" />
            <Button Content="LOGOUT" Click="OnLogoutClick" />
            <Button Content="REMOVE" Click="OnRemoveClick" />
        </StackPanel>
    </Grid>
</Page>
