<Page
    x:Class="UPM.SiteManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="20" RowSpacing="14" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="SETTINGS" />
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Site profiles, transfer performance, security and appearance" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource ControlRoomPanelStyle}" Padding="18">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="SITE PROFILE" />
                    <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="No saved Site profiles" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="ADD SITE" />
                    <TextBlock Grid.Row="1" Style="{StaticResource SectionTitleStyle}" Text="UPLOAD WORKERS" />
                    <NumberBox Grid.Row="1" Grid.Column="1" Width="140" HorizontalAlignment="Left" Minimum="1" Maximum="16" Value="4" SpinButtonPlacementMode="Compact" />
                    <TextBlock Grid.Row="2" Style="{StaticResource SectionTitleStyle}" Text="THEME" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectedIndex="0"><ComboBoxItem Content="Control Room (Default)" /><ComboBoxItem Content="Future theme support" IsEnabled="False" /></ComboBox>
                </Grid>
            </Border>
            <InfoBar Grid.Row="2" IsOpen="True" Severity="Informational" Title="Secure credential storage" Message="Session material is stored with Windows Credential Manager. Plaintext Site passwords are never persisted." />
        </Grid>
    </ScrollViewer>
</Page>
