<Application
    x:Class="UPM.SiteManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="GraphiteColor">#080D14</Color>
            <Color x:Key="PanelColor">#D90D1620</Color>
            <Color x:Key="PanelRaisedColor">#E514202C</Color>
            <Color x:Key="CyanColor">#26E6FF</Color>
            <Color x:Key="VioletColor">#A66CFF</Color>
            <Color x:Key="MutedColor">#92A8B8</Color>
            <Color x:Key="SuccessColor">#55E879</Color>
            <Color x:Key="WarningColor">#F1B94A</Color>
            <Color x:Key="FailureColor">#FF5C68</Color>
            <SolidColorBrush x:Key="GraphiteBrush" Color="{StaticResource GraphiteColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaisedColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CyanColor}" />
            <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="FailureBrush" Color="{StaticResource FailureColor}" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#334B5E" />
            <SolidColorBrush x:Key="TableRowBrush" Color="#B20B131D" />
            <SolidColorBrush x:Key="SelectedRowBrush" Color="#3326E6FF" />
            <Style x:Key="ControlRoomPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#DCE8F2" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>
            <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource ControlRoomPanelStyle}">
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="CompactButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="11,5" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
                <Setter Property="Padding" Value="7,4" />
                <Setter Property="MinWidth" Value="30" />
            </Style>
            <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinHeight" Value="31" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="#D90A121C" />
                <Setter Property="BorderBrush" Value="#354E63" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="CompactTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="31" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="#D90A121C" />
                <Setter Property="BorderBrush" Value="#354E63" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="DenseListRowStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,1" />
            </Style>
            <Style x:Key="StatusBadgeStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource CompactComboBoxStyle}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource CompactTextBoxStyle}" />
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DenseListRowStyle}" />
            <Style TargetType="NavigationViewItem">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Foreground" Value="#C8D7E2" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
